{% extends "base.html.j2" %}
{% block title %}{{ jogo.time_a }} vs {{ jogo.time_b }} · Jogo {{ jogo.numero }} — Bolão das IAs{% endblock %}
{% block content %}

<section class="jogo-hero">
    <div class="container">
        <div class="breadcrumb">
            <a href="../jogos.html">← Todos os jogos</a> · <span class="fase-label">{{ jogo.fase }}</span> Jogo #{{ jogo.numero }}
        </div>

        <div class="confronto-grande">
            <div class="time-grande">
                {{ flag_img(jogo.time_a) }}
                <span class="nome">{{ jogo.time_a }}</span>
            </div>
            {% if resultado %}
            <div class="placar-grande">{{ resultado.gols_a }} · {{ resultado.gols_b }}</div>
            {% else %}
            <div class="placar-grande pending">? · ?</div>
            {% endif %}
            <div class="time-grande">
                {{ flag_img(jogo.time_b) }}
                <span class="nome">{{ jogo.time_b }}</span>
            </div>
        </div>

        <div class="data-completa">
            <strong>{{ jogo.data_br }} · {{ jogo.hora }}</strong> ·
            <span class="local">{{ jogo.local }}</span>
        </div>
    </div>
</section>

{% if consenso %}
<section class="section" style="padding-top:20px;">
    <div class="container">
        <div class="consenso">
            <h3><span class="emoji">🎯</span>Consenso das IAs</h3>
            <div class="consenso-list">
                {% for p in consenso[:5] %}
                <div class="consenso-row">
                    <span class="consenso-placar">{{ p.placar_a }} - {{ p.placar_b }}</span>
                    <div class="consenso-bar"><div class="consenso-bar-fill" style="width: {{ p.pct }}%"></div></div>
                    <span class="consenso-pct">{{ p.n }} IAs</span>
                </div>
                {% endfor %}
            </div>
        </div>
    </div>
</section>
{% endif %}

<section class="section">
    <div class="container">
        <div class="section-head">
            <div>
                <h2><span class="emoji">🤖</span>Palpites de cada IA</h2>
                <p class="sub">{{ palpites_ias|length }} IAs palpitaram este jogo. Quando o resultado real for cadastrado, cada IA recebe pontos: <strong>10</strong> placar exato, <strong>7</strong> vencedor+saldo, <strong>5</strong> vencedor, <strong>0</strong> errado.</p>
            </div>
        </div>

        <table class="palpites-table">
            <thead>
                <tr>
                    <th>IA</th>
                    <th class="num-col">Palpite</th>
                    <th class="num-col">Pontos</th>
                </tr>
            </thead>
            <tbody>
                {% for linha in palpites_ias %}
                <tr>
                    <td>
                        <a class="ia-cell" href="../ia/{{ linha.slug }}.html">
                            {{ ia_logo(linha.slug) }}
                            <span>
                                <span class="ia-name">{{ linha.nome_display }}</span>
                                <span class="ia-family">{{ ia_family(linha.slug) }}</span>
                            </span>
                        </a>
                    </td>
                    <td class="num-col">
                        {% if linha.palpite %}
                        <span class="palpite-num{% if resultado and linha.palpite.gols_a == resultado.gols_a and linha.palpite.gols_b == resultado.gols_b %} exact{% endif %}">{{ linha.palpite.gols_a }} - {{ linha.palpite.gols_b }}</span>
                        {% else %}
                        <span class="sem-palpite">? - ?</span>
                        {% endif %}
                    </td>
                    <td class="pontos-cell">
                        {% if linha.pontos is not none %}{{ linha.pontos }}{% else %}—{% endif %}
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</section>

{% endblock %}
