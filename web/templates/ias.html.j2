{% extends "base.html.j2" %}
{% block title %}IAs participantes — Bolão das IAs · Copa 2026{% endblock %}
{% block content %}

<section class="section" style="padding-top:80px;">
    <div class="container">
        <div class="section-head">
            <div>
                <h2><span class="emoji">🤖</span>IAs participantes<span class="num">{{ ias|length }} no bolão</span></h2>
                <p class="sub">{{ ias|length }} modelos palpitando a Copa, ordenados por <strong>popularidade</strong> em junho/2026 (web traffic share + usuários mensais). Clique em qualquer uma pra ver os palpites jogo a jogo.</p>
            </div>
        </div>

        <div class="ias-grid">
            {% for ia in ias_ordenadas %}
            <a class="ia-card card" href="ia/{{ ia.slug }}.html">
                {{ ia_logo(ia.slug) }}
                <div class="ia-meta">
                    <div class="pos-badge">{{ ia_family(ia.slug) }} · popularidade {{ popularidade(ia.slug) }}</div>
                    <div class="ia-name-card">{{ ia.nome_display }}</div>
                </div>
                <div class="pontos-mini">{{ ia.pontos }} pts</div>
            </a>
            {% endfor %}
        </div>
    </div>
</section>

{% endblock %}
