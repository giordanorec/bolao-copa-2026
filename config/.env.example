# config/.env.example
# Copie para `config/.env` e preencha. NUNCA commite o arquivo real — está
# coberto pelo .gitignore. Em sessão multi-agente, qualquer agente que precise
# de credenciais deve pedir via secrets locais, não via prompt.

# --- OpenRouter (coletor F4.5) ------------------------------------------------
# Obrigatório pra `python -m bolao coletar` chamar a API.
# Gera em https://openrouter.ai/keys (formato: sk-or-v1-...)
OPENROUTER_API_KEY=sk-or-v1-REPLACE_ME

# Opcional mas recomendado pelo OpenRouter: identifica o referer da chamada,
# usado pra ranking de apps e analytics deles. Pode ser a URL do repo.
OPENROUTER_REFERER=https://github.com/giordano/bolao-da-copa

# Opcional: nome legível do app, aparece no dashboard do OpenRouter.
OPENROUTER_APP_NAME=Bolao da Copa 2026

# --- Limites operacionais (defaults estão no coletor) -------------------------
# Quantidade máxima de chamadas em paralelo (asyncio.Semaphore).
# OPENROUTER_MAX_PARALELO=5
#
# Timeout por requisição (segundos).
# OPENROUTER_TIMEOUT=120
