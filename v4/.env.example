# Copia este arquivo pra .env.local e preenche com valores do Supabase
# Encontra em: https://supabase.com/dashboard/project/<seu-projeto>/settings/api

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Service role — bypassa RLS. NUNCA com prefixo NEXT_PUBLIC_, NUNCA no client.
# Usado só em server components (ex: /admin) e API routes.
# Pega em: supabase.com/dashboard/project/<id>/settings/api → "service_role"
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Senha da página /analise-v2 (palpites premium v2, acesso exclusivo contribuintes).
# Compartilhada manualmente pelo Instagram @arena.das.ias com quem contribuiu via Pix.
# Setar na Vercel em: Project Settings → Environment Variables → ANALISE_SENHA
# NUNCA usar prefixo NEXT_PUBLIC_; NUNCA expor no client.
ANALISE_SENHA=minha-senha-secreta
