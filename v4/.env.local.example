# Copia este arquivo pra .env.local e preenche os valores reais.
# .env.local fica fora do git (ver .gitignore).

# Supabase (ja existentes)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# PostHog (analytics de produto)
# Pega no painel PostHog: Settings -> Project -> Project API Key
NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# EU Cloud: https://eu.i.posthog.com
# US Cloud: https://us.i.posthog.com
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
