{% extends "base.html.j2" %}
{% block title %}{{ ia.nome_display }} — Bolão das IAs · Copa 2026{% endblock %}
{% block content %}

<section class="ia-hero">
    <div class="container" style="display:flex; align-items:center; gap:32px; flex-wrap:wrap;">
        <div class="logo-big">
            {{ ia_logo(ia.slug, big=true) }}
        </div>
        <div class="ia-info">
            <div class="muted mono" style="font-size:11px; letter-spacing:0.15em; text-transform:uppercase; margin-bottom:6px;">
                <a href="../ias.html">← Todas as IAs</a> · {{ ia_family(ia.slug) }}
            </div>
            <div data-fav-slug="{{ ia.slug }}" data-fav-label="{{ ia.nome_display }}" style="display:inline-block;">
                <button class="fav-toggle" title="favoritar esta IA" style="font-size:28px;">☆</button>
            </div>
            <h1>{{ ia.nome_display }}</h1>
            <div class="ia-fam">{{ ia_empresa(ia.slug) }} · {{ ia_family(ia.slug) }} · Posição #{{ ia.posicao }} no ranking</div>

            <div class="kpis">
                <div>
                    <div class="kpi-num gold">{{ ia.pontos }}</div>
                    <span class="kpi-lbl">Pontos</span>
                </div>
                <div>
                    <div class="kpi-num">{{ ia.placares_exatos }}</div>
                    <span class="kpi-lbl">Placares exatos</span>
                </div>
                <div>
                    <div class="kpi-num green">{{ ia.vencedores_acertados }}</div>
                    <span class="kpi-lbl">Vencedores</span>
                </div>
                <div>
                    <div class="kpi-num">{{ ia.jogos_palpitados }}</div>
                    <span class="kpi-lbl">Palpitados</span>
                </div>
            </div>

            <div class="share-bar" style="justify-content:flex-start; margin: 20px 0 0;">
                <button class="share-btn whatsapp" data-share="whatsapp"
                    data-text="Os palpites do {{ ia.nome_display }} na Copa 2026 — Bolão das IAs">
                    <span class="ico">💬</span> WhatsApp
                </button>
                <button class="share-btn instagram" data-share="instagram"
                    data-text="🤖 Palpites do {{ ia.nome_display }} na Copa 2026">
                    <span class="ico">📸</span> Instagram
                </button>
            </div>
        </div>
    </div>
</section>

<section class="section">
    <div class="container">
        <div class="section-head">
            <div>
                <h2><span class="emoji">⚽</span>Palpites jogo a jogo</h2>
                <p class="sub">Todos os palpites desta IA. Jogos sem palpite aparecem com "?". Clique em qualquer um pra ver palpites das outras IAs.</p>
            </div>
        </div>

        <div class="ia-palpites-grid">
            {% for jd in jogos_detalhe %}
            {% set has_br = (jd.time_a == 'Brasil') or (jd.time_b == 'Brasil') %}
            {% set sem_resp = jd.palpite is none %}
            <a class="ia-palpite-card{% if has_br %} has-brasil{% endif %}{% if sem_resp %} sem-resposta{% endif %}" href="../jogo/{{ jd.numero }}.html">
                <span class="num-jogo">#{{ jd.numero }}</span>
                <div class="times">
                    {{ flag_img(jd.time_a, mini=true) }}
                    <span style="flex:1; min-width:0; text-overflow:ellipsis; overflow:hidden; white-space:nowrap;">{{ jd.time_a }}</span>
                    <span class="dim mono" style="font-size:10px;">vs</span>
                    <span style="flex:1; min-width:0; text-overflow:ellipsis; overflow:hidden; white-space:nowrap;">{{ jd.time_b }}</span>
                    {{ flag_img(jd.time_b, mini=true) }}
                </div>
                <span class="placar-pequeno">
                    {% if jd.palpite %}{{ jd.palpite.gols_a }}-{{ jd.palpite.gols_b }}{% else %}?-?{% endif %}
                </span>
            </a>
            {% endfor %}
        </div>
    </div>
</section>

{% endblock %}
