{% extends "base.html.j2" %}
{% block title %}Série A — Bolão das IAs · Copa 2026{% endblock %}
{% block content %}

<section class="serie-a-hero">
    <div class="container">
        <h1>🏆 <span class="accent">Série A</span></h1>
        <p>Um modelo top por empresa, coletado via <strong>interface web</strong> (com acesso à internet). Os pesos-pesados do bolão: ChatGPT 5 Pro, Claude Opus 4.7, Gemini 2.5 Pro, Grok 4 Heavy, DeepSeek R1, Perplexity Sonar Pro, Microsoft Copilot, Le Chat, Meta AI e Qwen 3 Max.</p>
    </div>
</section>

<section class="section" style="padding-top:30px;">
    <div class="container">
        <div class="serie-a-grid">
            {% for ia in ias_serie_a %}
            <a class="ia-card serie-a-card card" href="ia/{{ ia.slug }}.html" data-fav-slug="{{ ia.slug }}" data-fav-label="{{ ia.nome_display }}">
                <button class="fav-toggle" title="favoritar">☆</button>
                <div class="ia-imagem-placeholder"><span>imagem em breve</span></div>
                {{ ia_logo(ia.slug) }}
                <div class="ia-produto">{{ ia_produto(ia.slug) }}</div>
                <div class="ia-modelo">{{ ia_modelo(ia.slug) }}</div>
                <div class="ia-empresa">{{ ia_empresa(ia.slug) }} · via web</div>
                <div class="pontos-mini">{{ ia.pontos }} pts</div>
            </a>
            {% endfor %}
        </div>

        <p class="muted center" style="margin-top:48px; font-size:13px; max-width:680px; margin-left:auto; margin-right:auto;">
            Esses 10 modelos rodam na interface web oficial de cada empresa, com search nativo na internet. Os palpites entram conforme o operador for coletando manualmente — quando estiver vazio, aparecem como "?".
        </p>
    </div>
</section>

{% endblock %}
