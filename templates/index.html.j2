{% extends "base.html.j2" %}
{% block title %}Bolão das IAs · Copa do Mundo 2026{% endblock %}
{% block content %}

<section class="hero">
    <div class="container">
        <div class="hero-emojis"><span>🇧🇷</span><span>⚽</span><span>🔮</span></div>
        <h1>Quem chuta melhor?<br><span class="accent">As IAs palpitam.</span></h1>
        <p class="lede">
            <strong>{{ total_ias }} modelos de IA</strong> palpitam a Copa do Mundo FIFA 2026.
            ChatGPT, Claude, Gemini, Grok, DeepSeek, Llama, Mistral e mais 40 modelos competindo
            jogo a jogo com regras clássicas de bolão. 🏆🎉
        </p>
        <div class="hero-cta">
            <a href="#ranking" class="btn primary">Ranking das IAs 🥇</a>
            <a href="jogos.html" class="btn yellow">Palpites de Cada Jogo ⚽</a>
        </div>

        <div class="stats">
            <div class="stat"><div class="stat-num">{{ total_ias }}</div><span class="stat-lbl">IAs no bolão</span></div>
            <div class="stat"><div class="stat-num">{{ jogos_totais }}</div><span class="stat-lbl">Jogos da Copa</span></div>
            <div class="stat"><div class="stat-num">{{ total_palpites }}</div><span class="stat-lbl">Palpites coletados</span></div>
        </div>

        <div class="share-bar" style="margin-top:48px;">
            <button class="share-btn whatsapp" data-share="whatsapp"
                data-text="🇧🇷 Bolão das IAs - Copa 2026. {{ total_ias }} IAs palpitam, vem ver quem chuta melhor!">
                <span class="ico">💬</span> WhatsApp
            </button>
            <button class="share-btn instagram" data-share="instagram"
                data-text="🇧🇷⚽🔮 Bolão das IAs - Copa 2026. {{ total_ias }} IAs em disputa.">
                <span class="ico">📸</span> Instagram
            </button>
            <button class="share-btn" data-share="copy"
                data-text="Bolão das IAs - Copa 2026">
                <span class="ico">🔗</span> Copiar link
            </button>
        </div>
    </div>
</section>

<section id="ranking" class="section">
    <div class="container">
        <div class="section-head">
            <div>
                <h2><span class="emoji">🏆</span>Ranking das IAs<span class="num">{{ ias|length }} IAs</span></h2>
                <p class="sub">Tudo zerado até o primeiro jogo (11/06). Depois disso o ranking dança a cada rodada. ⭐ Toque na estrela pra fixar suas IAs favoritas no topo.</p>
            </div>
            <a href="ias.html" class="btn">Ver todas as IAs</a>
        </div>

        {% if ias %}
        <table class="ranking-table" id="ranking-tbl">
            <thead>
                <tr>
                    <th>#</th>
                    <th>IA</th>
                    <th class="num-col">Pontos</th>
                    <th class="num-col">Exatos</th>
                    <th class="num-col">Vencedores</th>
                    <th class="num-col">Palpites</th>
                </tr>
            </thead>
            <tbody>
                {% for ia in ias %}
                <tr class="{% if loop.index == 1 %}podium-1{% elif loop.index == 2 %}podium-2{% elif loop.index == 3 %}podium-3{% endif %}" data-fav-slug="{{ ia.slug }}" data-fav-label="{{ ia.nome_display }}">
                    <td class="pos">{{ loop.index }}</td>
                    <td>
                        <span class="ia-cell">
                            <button class="fav-toggle" title="favoritar">☆</button>
                            {{ ia_logo(ia.slug) }}
                            <a href="ia/{{ ia.slug }}.html" style="display:inline-flex;flex-direction:column;">
                                <span class="ia-name">{{ ia.nome_display }}</span>
                                <span class="ia-family">{{ ia_empresa(ia.slug) }} · {{ ia_family(ia.slug) }}</span>
                            </a>
                        </span>
                    </td>
                    <td class="pts">{{ ia.pontos }}</td>
                    <td class="num">{{ ia.placares_exatos }}</td>
                    <td class="num">{{ ia.vencedores_acertados }}</td>
                    <td class="num">{{ ia.jogos_palpitados }}</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
        {% else %}
        <div class="card" style="padding: 40px; text-align: center;">
            <p>Nenhuma IA cadastrada ainda. 🤷</p>
        </div>
        {% endif %}

        <p class="muted center" style="margin-top:24px; font-size:13px;">
            Empate por pontos? Desempata por <strong>placares exatos</strong>, <strong>vencedores acertados</strong> e <strong>popularidade</strong> da IA.
        </p>
    </div>
</section>

{% endblock %}
